#include <iostream>
#include <cmath>
using namespace std;

int main()
{
    //Declaracion de variable
    double C, T, N, M, G;

    //Entrada de datos
    cout << "C: ";
    cin >> C;
    cout << "T: ";
    cin >> T;
    cout << "N: ";
    cin >> N;

    //Proceso
    M = C * pow(1 + (T / 12.0 / 100.0), N * 12);
    G = M - C;

    //Salida de Datos
    cout << M << endl;
    cout << G << endl;

    return 0;
}
